{
  "seguimiento_riesgo": {
    "$and": [
      {
        "$jsonSchema": {
          "bsonType": "object",
          "title": "Seguimiento conductual SIMULADO por estudiante y período",
          "required": ["estudiante_id", "periodo", "periodo_inicio", "periodo_fin",
                       "interacciones_lms", "tutorias", "es_simulado", "fuente"],
          "additionalProperties": false,
          "properties": {
            "_id": {},
            "estudiante_id": {"bsonType": "int", "minimum": 1},
            "periodo": {"enum": ["P1", "P2", "P3"]},
            "periodo_inicio": {"bsonType": "date"},
            "periodo_fin": {"bsonType": "date"},
            "es_simulado": {"enum": [true]},
            "fuente": {"bsonType": "string"},
            "interacciones_lms": {
              "bsonType": "array",
              "items": {
                "bsonType": "object",
                "required": ["evento_id", "asignatura", "fecha", "tipo", "duracion_min"],
                "additionalProperties": false,
                "properties": {
                  "evento_id": {"bsonType": "string", "pattern": "^EV-[0-9]{7}$"},
                  "asignatura": {"enum": ["MAT", "POR"]},
                  "fecha": {"bsonType": "date"},
                  "tipo": {"enum": ["recurso", "tarea", "foro", "cuestionario"]},
                  "duracion_min": {"bsonType": ["int", "null"], "minimum": 1, "maximum": 240},
                  "revisada": {"bsonType": "bool"}
                }
              }
            },
            "tutorias": {
              "bsonType": "array",
              "items": {
                "bsonType": "object",
                "required": ["tutoria_id", "asignatura", "fecha", "tutor", "modalidad", "tema", "resultado"],
                "additionalProperties": false,
                "properties": {
                  "tutoria_id": {"bsonType": "string", "pattern": "^TU-[0-9]{5}$"},
                  "asignatura": {"enum": ["MAT", "POR"]},
                  "fecha": {"bsonType": "date"},
                  "tutor": {"bsonType": "string", "pattern": "^TUT-[0-9]{2}$"},
                  "modalidad": {"enum": ["presencial", "virtual"]},
                  "tema": {"enum": ["rendimiento_academico", "asistencia", "tecnicas_estudio", "orientacion_personal"]},
                  "resultado": {"enum": ["completada", "no_asistio", "reprogramada"]}
                }
              }
            }
          }
        }
      },
      {
        "$expr": {
          "$and": [
            {"$allElementsTrue": [{"$map": {"input": "$interacciones_lms", "as": "e",
              "in": {"$and": [{"$gte": ["$$e.fecha", "$periodo_inicio"]}, {"$lte": ["$$e.fecha", "$periodo_fin"]}]}}}]},
            {"$allElementsTrue": [{"$map": {"input": "$tutorias", "as": "t",
              "in": {"$and": [{"$gte": ["$$t.fecha", "$periodo_inicio"]}, {"$lte": ["$$t.fecha", "$periodo_fin"]}]}}}]}
          ]
        }
      }
    ]
  },
  "alertas_riesgo": {
    "$and": [
      {
        "$jsonSchema": {
          "bsonType": "object",
          "title": "Alerta de riesgo SIMULADA con ciclo de vida y notas de texto libre",
          "required": ["alerta_id", "estudiante_id", "asignatura", "periodo", "nivel", "estado",
                       "creada_en", "actualizado_en", "historial_estados", "notas", "es_simulado", "fuente"],
          "properties": {
            "alerta_id": {"bsonType": "string", "pattern": "^AL-[0-9]{5}$"},
            "estudiante_id": {"bsonType": "int", "minimum": 1},
            "asignatura": {"enum": ["MAT", "POR"]},
            "periodo": {"enum": ["P1", "P2", "P3"]},
            "nivel": {"enum": ["bajo", "medio", "alto"]},
            "estado": {"enum": ["abierta", "en_seguimiento", "cerrada"]},
            "creada_en": {"bsonType": "date"},
            "actualizado_en": {"bsonType": "date"},
            "es_simulado": {"enum": [true]},
            "fuente": {"bsonType": "string"},
            "historial_estados": {
              "bsonType": "array", "minItems": 1,
              "items": {"bsonType": "object", "required": ["estado", "fecha"],
                        "properties": {"estado": {"enum": ["abierta", "en_seguimiento", "cerrada"]},
                                       "fecha": {"bsonType": "date"}}}
            },
            "notas": {
              "bsonType": "array",
              "items": {"bsonType": "object",
                        "required": ["nota_id", "fecha", "autor", "texto", "texto_normalizado", "categoria"],
                        "properties": {
                          "nota_id": {"bsonType": "string"},
                          "fecha": {"bsonType": "date"},
                          "autor": {"bsonType": "string", "pattern": "^ORI-[0-9]{2}$"},
                          "texto": {"bsonType": "string", "minLength": 5},
                          "texto_normalizado": {"bsonType": "string"},
                          "categoria": {"enum": ["academico", "asistencia", "familiar", "conducta", "motivacion", "indeterminada"]}
                        }}
            }
          }
        }
      },
      {
        "$expr": {
          "$and": [
            {"$gte": ["$actualizado_en", "$creada_en"]},
            {"$gte": ["$actualizado_en", {"$max": "$historial_estados.fecha"}]},
            {"$gte": ["$actualizado_en", {"$ifNull": [{"$max": "$notas.fecha"}, "$creada_en"]}]},
            {"$gte": [{"$ifNull": [{"$min": "$notas.fecha"}, "$creada_en"]}, "$creada_en"]},
            {"$eq": ["$estado", {"$arrayElemAt": ["$historial_estados.estado", -1]}]},
            {"$eq": [{"$arrayElemAt": ["$historial_estados.estado", 0]}, "abierta"]}
          ]
        }
      }
    ]
  }
}

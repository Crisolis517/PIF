{
  "AG-01_lms_por_matricula_periodo": {
    "coleccion": "seguimiento_riesgo",
    "descripcion": "Aplana interacciones_lms ($unwind) y agrega actividad por estudiante, asignatura y período. Alimenta las variables sim_lms_* del dataset.",
    "pipeline": [
      {"$unwind": "$interacciones_lms"},
      {"$group": {
        "_id": {"estudiante_id": "$estudiante_id", "asignatura": "$interacciones_lms.asignatura", "periodo": "$periodo"},
        "n_eventos": {"$sum": 1},
        "minutos": {"$sum": {"$ifNull": ["$interacciones_lms.duracion_min", 0]}},
        "n_tareas": {"$sum": {"$cond": [{"$eq": ["$interacciones_lms.tipo", "tarea"]}, 1, 0]}},
        "n_tareas_revisadas": {"$sum": {"$cond": [{"$eq": ["$interacciones_lms.revisada", true]}, 1, 0]}},
        "dias": {"$addToSet": {"$dateToString": {"format": "%Y-%m-%d", "date": "$interacciones_lms.fecha"}}}
      }},
      {"$project": {
        "_id": 0, "estudiante_id": "$_id.estudiante_id", "asignatura": "$_id.asignatura", "periodo": "$_id.periodo",
        "n_eventos": 1, "minutos": 1, "n_tareas": 1, "n_tareas_revisadas": 1, "dias_activos": {"$size": "$dias"}
      }},
      {"$sort": {"estudiante_id": 1, "asignatura": 1, "periodo": 1}}
    ]
  },
  "AG-02_tutorias_por_matricula": {
    "coleccion": "seguimiento_riesgo",
    "descripcion": "Aplana tutorias y cuenta sesiones y sesiones completadas por matrícula (P2–P3).",
    "pipeline": [
      {"$unwind": "$tutorias"},
      {"$group": {
        "_id": {"estudiante_id": "$estudiante_id", "asignatura": "$tutorias.asignatura"},
        "n_tutorias": {"$sum": 1},
        "n_tutorias_completadas": {"$sum": {"$cond": [{"$eq": ["$tutorias.resultado", "completada"]}, 1, 0]}},
        "primera_tutoria": {"$min": "$tutorias.fecha"}
      }},
      {"$project": {"_id": 0, "estudiante_id": "$_id.estudiante_id", "asignatura": "$_id.asignatura",
                    "n_tutorias": 1, "n_tutorias_completadas": 1, "primera_tutoria": 1}}
    ]
  },
  "AG-03_alertas_por_matricula": {
    "coleccion": "alertas_riesgo",
    "descripcion": "Resume alertas por matrícula: número, nivel máximo (ordinal) y si alguna quedó cerrada.",
    "pipeline": [
      {"$project": {"estudiante_id": 1, "asignatura": 1, "estado": 1,
                    "nivel_num": {"$switch": {"branches": [
                      {"case": {"$eq": ["$nivel", "bajo"]}, "then": 1},
                      {"case": {"$eq": ["$nivel", "medio"]}, "then": 2},
                      {"case": {"$eq": ["$nivel", "alto"]}, "then": 3}], "default": 0}},
                    "n_notas": {"$size": "$notas"}}},
      {"$group": {"_id": {"estudiante_id": "$estudiante_id", "asignatura": "$asignatura"},
                  "n_alertas": {"$sum": 1}, "nivel_alerta_max": {"$max": "$nivel_num"},
                  "alerta_cerrada": {"$max": {"$cond": [{"$eq": ["$estado", "cerrada"]}, 1, 0]}},
                  "n_notas": {"$sum": "$n_notas"}}},
      {"$project": {"_id": 0, "estudiante_id": "$_id.estudiante_id", "asignatura": "$_id.asignatura",
                    "n_alertas": 1, "nivel_alerta_max": 1, "alerta_cerrada": 1, "n_notas": 1}}
    ]
  },
  "AG-04_alertas_con_tutoria_posterior": {
    "coleccion": "alertas_riesgo",
    "descripcion": "$lookup a seguimiento_riesgo: ¿cada alerta tuvo al menos una tutoría de la misma asignatura posterior a su creación? Resumen por nivel.",
    "pipeline": [
      {"$lookup": {
        "from": "seguimiento_riesgo",
        "let": {"e": "$estudiante_id", "a": "$asignatura", "f": "$creada_en"},
        "pipeline": [
          {"$match": {"$expr": {"$eq": ["$estudiante_id", "$$e"]}}},
          {"$unwind": "$tutorias"},
          {"$match": {"$expr": {"$and": [{"$eq": ["$tutorias.asignatura", "$$a"]}, {"$gte": ["$tutorias.fecha", "$$f"]}]}}},
          {"$count": "n"}
        ],
        "as": "tut"
      }},
      {"$project": {"nivel": 1, "estado": 1, "n_tut": {"$ifNull": [{"$arrayElemAt": ["$tut.n", 0]}, 0]}}},
      {"$group": {"_id": "$nivel", "n_alertas": {"$sum": 1},
                  "con_tutoria_posterior": {"$sum": {"$cond": [{"$gt": ["$n_tut", 0]}, 1, 0]}},
                  "cerradas": {"$sum": {"$cond": [{"$eq": ["$estado", "cerrada"]}, 1, 0]}}}},
      {"$project": {"_id": 0, "nivel": "$_id", "n_alertas": 1, "con_tutoria_posterior": 1, "cerradas": 1,
                    "pct_con_tutoria": {"$round": [{"$multiply": [{"$divide": ["$con_tutoria_posterior", "$n_alertas"]}, 100]}, 1]}}},
      {"$sort": {"nivel": 1}}
    ]
  },
  "AG-05_estado_nivel": {
    "coleccion": "alertas_riesgo",
    "descripcion": "Distribución de alertas por nivel y estado del ciclo de vida.",
    "pipeline": [
      {"$group": {"_id": {"nivel": "$nivel", "estado": "$estado"}, "n": {"$sum": 1}}},
      {"$project": {"_id": 0, "nivel": "$_id.nivel", "estado": "$_id.estado", "n": 1}},
      {"$sort": {"nivel": 1, "estado": 1}}
    ]
  },
  "AG-06_categorias_texto": {
    "coleccion": "alertas_riesgo",
    "descripcion": "Aplana notas de texto libre y cuenta categorías inferidas por nivel de alerta.",
    "pipeline": [
      {"$unwind": "$notas"},
      {"$group": {"_id": {"categoria": "$notas.categoria", "nivel": "$nivel"}, "n": {"$sum": 1}}},
      {"$project": {"_id": 0, "categoria": "$_id.categoria", "nivel": "$_id.nivel", "n": 1}},
      {"$sort": {"categoria": 1, "nivel": 1}}
    ]
  },
  "AG-07_busqueda_texto": {
    "coleccion": "alertas_riesgo",
    "descripcion": "Búsqueda de texto completo (índice tx_notas) de notas que mencionan inasistencias; conteo por nivel.",
    "pipeline": [
      {"$match": {"$text": {"$search": "inasistencias ausencias faltas"}}},
      {"$group": {"_id": "$nivel", "n_alertas": {"$sum": 1}}},
      {"$project": {"_id": 0, "nivel": "$_id", "n_alertas": 1}},
      {"$sort": {"nivel": 1}}
    ]
  }
}
